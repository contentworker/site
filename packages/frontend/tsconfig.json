{
  // The Worker, its server-side block renderers, tooling and tests. Never emitted: wrangler
  // bundles the Worker (esbuild) and Node runs the rest with type stripping, so only syntax that
  // can be erased is allowed (no enums, namespaces or parameter properties).
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "src",
    "public/blocks/**/*.render.ts",
    "public/scripts/shared.js",
    "scripts",
    "test",
    "worker-configuration.d.ts"
  ]
}
