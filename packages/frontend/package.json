{
  "name": "@contentworker/frontend",
  "version": "0.2.0",
  "description": "The ContentWorker site runtime: edge-cached rendering from the Delivery API, purge on publish, preview, SEO and GEO, and the primary blocks, styles and scripts. Sites need only a wrangler.jsonc.",
  "keywords": [
    "contentworker",
    "cloudflare",
    "workers",
    "cms",
    "headless",
    "edge",
    "starter"
  ],
  "homepage": "https://contentworker.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/contentworker/site",
    "directory": "packages/frontend"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./entry": "./src/entry.ts"
  },
  "bin": {
    "contentworker-site": "dist/scripts/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "budgets.json",
    "content-model",
    "dist",
    "public",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/embed-assets.ts",
    "prepack": "npm run build",
    "check-types": "npm run generate && tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "npm run generate && node --import ./test/support/register.ts --test \"test/**/*.test.ts\"",
    "budgets": "node scripts/check-budgets.ts",
    "lighthouse": "npm run generate && node scripts/lighthouse-gate.ts",
    "mock-delivery": "node scripts/mock-delivery.ts",
    "seed": "node scripts/seed.ts",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "cli": "node scripts/cli.ts",
    "new-runtime-block": "node scripts/new-block.ts",
    "new-site-block": "node scripts/site-new-block.ts"
  },
  "peerDependencies": {
    "wrangler": ">=4.107.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "chrome-launcher": "1.2.2",
    "jsdom": "30.1.3",
    "lighthouse": "13.6.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@contentworker/sdk": "^0.1.0"
  }
}
