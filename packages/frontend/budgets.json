{
  "$comment": "Gzip byte budgets for public/ (docs/budget.md explains each). CI fails a PR over budget. Raise a number only with a measured reason in docs/budget.md.",
  "groups": [
    {
      "name": "critical CSS (render-blocking, with site.css)",
      "files": ["styles/critical.css", "styles/site.css"],
      "max": 8192
    },
    {
      "name": "critical JS",
      "files": ["scripts/enhance.js", "scripts/boot.js", "scripts/shared.js"],
      "max": 10240
    },
    {
      "name": "deferred CSS",
      "files": ["styles/deferred.css", "styles/fonts.css"],
      "max": 8192
    },
    {
      "name": "idle JS",
      "files": ["scripts/idle.js", "scripts/consent.js", "scripts/consented.js"],
      "max": 20480
    }
  ],
  "perBlock": {
    "css": 3072,
    "js": 4096
  },
  "blockExceptions": {}
}
