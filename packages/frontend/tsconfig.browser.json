{
  // What the browser loads, exactly as written: plain JavaScript, type-checked through JSDoc.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["public/**/*.js"],
  // The vendored SDK build is checked by its own types (the generated .d.ts beside it).
  "exclude": ["public/scripts/vendor/**"]
}
